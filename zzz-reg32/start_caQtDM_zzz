#!/bin/csh -f

setenv EPICS_APP /net/s100dserv/xorApps/zed/epics/ioc_6_2_1/zzz
setenv EPICS_APP_NAME zzz
# define environment variables for MEDM, caQtDM, and Probe
source ./setup_epics_common

# For drag-and-drop workaround:
